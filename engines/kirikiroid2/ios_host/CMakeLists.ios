# =============================================================================
# Kirikinux2 iOS 构建清单 —— 基于 Kirikinux2 的 Linux CMakeLists 移植
#
# 产物（全部静态库，输出到 CMAKE_BINARY_DIR）:
#   libkrkr2core.a      引擎核心（TJS2/存储/图层/声音/UI 界面）
#   libkrkr2plugin.a    内置插件
#   libkrkr2plugin_ext.a  KrKr2 移植插件
#   libcocos2d.a        cocos2d-x 3.17.2（iOS 平台，含音频/输入/GL）
#
# App 目标（Xcode, com.yg.kirikinux2）链接以上库 + ios_host/IOSMain.mm。
# =============================================================================
cmake_minimum_required(VERSION 3.20)
project(Kirikinux2-iOS CXX C OBJC OBJCXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# ---- 输入（由 build_ios.sh 以缓存变量传入） ----
#   KR2_ROOT        Kirikinux2 源码树
#   KR2_COCOS2DX_ROOT  已 patch 的 cocos2d-x 3.17.2 源码树
#   KR2_THIRD_PARTY    第三方依赖目录

message(STATUS "[KR2-IOS] KR2_ROOT=${KR2_ROOT}")
message(STATUS "[KR2-IOS] COCOS=${KR2_COCOS2DX_ROOT}")

if(NOT EXISTS "${KR2_COCOS2DX_ROOT}/cocos/cocos2d.h")
  message(FATAL_ERROR "cocos2d-x not found in ${KR2_COCOS2DX_ROOT}")
endif()

set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_LUA_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_JS_LIBS OFF CACHE BOOL "" FORCE)
set(COCOS2DX_ROOT_PATH "${KR2_COCOS2DX_ROOT}")
list(APPEND CMAKE_MODULE_PATH "${COCOS2DX_ROOT_PATH}/cmake/Modules/")
include(CocosBuildSet)
add_subdirectory("${COCOS2DX_ROOT_PATH}/cocos" "${CMAKE_BINARY_DIR}/cocos/core")

# ---- 平台源文件（iOS 宿主替代 platform/linux/*） ----
set(KR2_PLATFORM_SOURCES
  ${KR2_ROOT}/platform/ios/IOSUtils.cpp
  ${KR2_ROOT}/platform/ios/KR2IOSStubs.cpp)

include(${KR2_ROOT}/cmake/Kr2Sources.cmake)

# iOS MVP 排除: ffmpeg 视频解码（stub，BPG/JXR/XP3Repack 同 Linux 排除集）
list(REMOVE_ITEM KR2_CORE_SOURCES ${KR2_FFMPEG_USERS})

set(KR2_CORE_INCLUDE_DIRS
  ${KR2_ROOT}/platform/ios/compat
  ${KR2_CORE}
  ${KR2_CORE}/base
  ${KR2_CORE}/base/win32
  ${KR2_CORE}/environ
  ${KR2_CORE}/environ/win32
  ${KR2_CORE}/environ/sdl
  ${KR2_CORE}/msg
  ${KR2_CORE}/msg/win32
  ${KR2_CORE}/extension
  ${KR2_CORE}/sound
  ${KR2_CORE}/sound/win32
  ${KR2_CORE}/tjs2
  ${KR2_CORE}/utils
  ${KR2_CORE}/utils/win32
  ${KR2_CORE}/visual
  ${KR2_CORE}/visual/ARM
  ${KR2_CORE}/visual/win32
  ${KR2_ROOT}/src/plugins
  ${KR2_ROOT}/cocos/kr2)

set(KR2_COCOS_INCLUDE_DIRS
  "${KR2_COCOS2DX_ROOT}"
  "${KR2_COCOS2DX_ROOT}/cocos"
  "${KR2_COCOS2DX_ROOT}/cocos/platform"
  "${KR2_COCOS2DX_ROOT}/cocos/editor-support"
  "${KR2_COCOS2DX_ROOT}/cocos/audio/include"
  "${KR2_COCOS2DX_ROOT}/extensions"
  "${KR2_COCOS2DX_ROOT}/external")

set(KR2_COMMON_OPTIONS
  -fno-delete-null-pointer-checks
  -Wno-deprecated-declarations
  -Wno-unused-result
  -Wno-inconsistent-missing-override
  -Wno-nullability-completeness
  -Wno-shorten-64-to-32)

# 与 src/core/Android.mk 相同的定义集（LINUX 保留: 走 POSIX 分支，iOS 与之一致）
set(KR2_COMMON_DEFINITIONS TJS_TEXT_OUT_CRLF __STDC_CONSTANT_MACROS USE_UNICODE_FSTRING _7ZIP_ST LINUX KR2_IOS)

# ---- 核心库 ----
add_library(krkr2core STATIC ${KR2_CORE_SOURCES} ${KR2_PLATFORM_SOURCES})
target_include_directories(krkr2core PRIVATE ${KR2_CORE_INCLUDE_DIRS} ${KR2_COCOS_INCLUDE_DIRS})
target_compile_definitions(krkr2core PRIVATE ${KR2_COMMON_DEFINITIONS})
target_compile_options(krkr2core PRIVATE ${KR2_COMMON_OPTIONS})
# 音频: iOS 系统 OpenAL 框架（与 Linux 版 KR2_OPENAL 对应）
target_link_libraries(krkr2core PUBLIC
  "-framework OpenAL"
  "-framework UIKit"
  "-framework Foundation"
  "-framework CoreGraphics"
  "-framework GLKit"
  "-framework OpenGLES"
  "-framework Metal"
  "-framework MetalKit"
  "-framework MetalFXTAGS_BULLET")

# ---- 插件 ----
add_library(krkr2plugin STATIC ${KR2_PLUGIN_SOURCES})
target_include_directories(krkr2plugin PRIVATE ${KR2_CORE_INCLUDE_DIRS} ${KR2_COCOS_INCLUDE_DIRS})
target_compile_definitions(krkr2plugin PRIVATE ${KR2_COMMON_DEFINITIONS})
target_compile_options(krkr2plugin PRIVATE ${KR2_COMMON_OPTIONS})
target_link_libraries(krkr2plugin PUBLIC krkr2core)

file(GLOB KR2_PLUGIN_EXT_SOURCES CONFIGURE_DEPENDS ${KR2_ROOT}/src/plugins/ext/*.cpp)
add_library(krkr2plugin_ext STATIC ${KR2_PLUGIN_EXT_SOURCES})
target_include_directories(krkr2plugin_ext PRIVATE ${KR2_CORE_INCLUDE_DIRS} ${KR2_COCOS_INCLUDE_DIRS})
target_compile_definitions(krkr2plugin_ext PRIVATE ${KR2_COMMON_DEFINITIONS})
target_compile_options(krkr2plugin_ext PRIVATE ${KR2_COMMON_OPTIONS})
target_link_libraries(krkr2plugin_ext PUBLIC krkr2plugin)

message(STATUS "[KR2-IOS] 配置完成: krkr2core(${#KR2_CORE_SOURCES}) plugin(${#KR2_PLUGIN_SOURCES})")
